<Window x:Class="Spotify.DownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="? Download from YouTube"
        Height="320" Width="560" MinHeight="280" MinWidth="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgDark}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Download from YouTube"
                   FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource AccentRed}" Margin="0,0,0,16"/>

        <!-- URL input -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="UrlTextBox" Style="{StaticResource CasinoTextBox}"
                     Margin="0,0,8,0"
                     Tag="Paste YouTube URL or playlist URL..."/>
            <Button Grid.Column="1" x:Name="DownloadBtn" Content="Download"
                    Style="{StaticResource RedAccentBtn}"
                    Click="DownloadBtn_Click"/>
        </Grid>

        <!-- Progress bar -->
        <Grid Grid.Row="2" Height="6" Margin="0,0,0,8">
            <Border Background="{StaticResource BgHover}" CornerRadius="3"/>
            <Border x:Name="DownloadProgressFill" Background="{StaticResource AccentRed}"
                    CornerRadius="3" HorizontalAlignment="Left" Width="0"/>
        </Grid>

        <!-- Status text -->
        <TextBlock Grid.Row="3" x:Name="StatusText" Text="Paste a YouTube video or playlist URL and click Download."
                   FontSize="12" Foreground="{StaticResource TextSecondary}"
                   TextWrapping="Wrap" Margin="0,0,0,8"/>

        <!-- Downloaded count -->
        <TextBlock Grid.Row="4" x:Name="CountText" Text=""
                   FontSize="11" Foreground="{StaticResource TextDim}" Margin="0,0,0,8"/>

        <!-- Close button -->
        <Button Grid.Row="5" x:Name="CloseBtn" Content="Close" 
                Style="{StaticResource DarkBtn}"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Click="CloseBtn_Click"/>
    </Grid>
</Window>
