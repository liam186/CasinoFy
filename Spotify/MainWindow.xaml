<Window x:Class="Spotify.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Spotify"
        mc:Ignorable="d"
        Title="♠ Casino Player" Height="580" Width="800"
        Background="{StaticResource BgDark}"
        WindowStyle="SingleBorderWindow">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== TOP: Add / Remove ===== -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="♠  ♥ Casinofy ♦  ♣" FontSize="30" FontWeight="Bold" TextAlignment="Center"
                       Foreground="{StaticResource AccentRed}" Margin="0,0,0,16"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="+ Add Songs" Style="{StaticResource RedAccentBtn}"
                        Click="AddSongBtn_Click" Margin="0,0,6,0"/>
                <Button Content="⬇ YouTube" Style="{StaticResource RedAccentBtn}"
                        Click="DownloadBtn_Click" Margin="0,0,6,0"/>
                <Button Content="Remove" Style="{StaticResource DarkBtn}"
                        Click="RemoveSongBtn_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- ===== CENTER: Song list ===== -->
        <Border Grid.Row="1" Background="{StaticResource BgCard}" CornerRadius="8"
                Padding="4" Margin="0,0,0,16">
            <ListBox x:Name="SongListBox"
                     Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource SongItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="SongListBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="36" Height="36" CornerRadius="4"
                                    Background="{StaticResource BgElevated}" Margin="0,0,10,0"
                                    ClipToBounds="True">
                                <Grid Width="36" Height="36">
                                    <Grid.Clip>
                                        <RectangleGeometry Rect="0,0,36,36" RadiusX="4" RadiusY="4"/>
                                    </Grid.Clip>

                                    <!-- Placeholder icon shown when no cover exists -->
                                    <TextBlock Text="♠" FontSize="16"
                                               Foreground="{StaticResource AccentRed}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CoverImage}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- Album cover image -->
                                    <Image Source="{Binding CoverImage}" Stretch="UniformToFill"
                                           Width="36" Height="36"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CoverImage}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- ===== PLAYER ===== -->
        <Border Grid.Row="2" Background="{StaticResource BgCard}" CornerRadius="8"
                Padding="20,16" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="136"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Album art -->
                <Border Background="{StaticResource BgElevated}" CornerRadius="8"
                        Width="120" Height="120" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock x:Name="AlbumArtPlaceholder" Text="♠" FontSize="52"
                                   Foreground="{StaticResource AccentRed}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Image x:Name="AlbumArtImage" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                </Border>

                <!-- Right side: info + controls -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="Music_name" Text="Select a song"
                                   FontSize="16" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimary}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" x:Name="TimeStamp" Text="0:00"
                                   FontSize="12" Foreground="{StaticResource TextDim}"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Progress bar -->
                    <Grid Height="4" Margin="0,0,0,10">
                        <Border Background="{StaticResource BgHover}" CornerRadius="2"/>
                        <Border x:Name="ProgressFill" Background="{StaticResource AccentRed}"
                                CornerRadius="2" HorizontalAlignment="Left" Width="0"/>
                    </Grid>

                    <!-- Transport + volume -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource TransportBtn}" Content="⏮"
                                    Click="BackBtn_Click"/>
                            <Button x:Name="PlayPauseBtn" Style="{StaticResource PlayBtn}" Content="▶"
                                    Click="PlayPauseBtn_Click" Margin="4,0"/>
                            <Button Style="{StaticResource TransportBtn}" Content="⏭"
                                    Click="NextBtn_Click"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="VolumeIcon" Text="🔊" FontSize="13"
                                       Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <Slider x:Name="VolumeSlider" Style="{StaticResource CasinoSlider}"
                                    Width="100" Value="100" Minimum="0" Maximum="100"
                                    VerticalAlignment="Center"
                                    ValueChanged="VolumeSlider_ValueChanged"/>
                            <TextBlock x:Name="VolumePercent" Text="100%" FontSize="11"
                                       Foreground="{StaticResource TextDim}" VerticalAlignment="Center"
                                       Margin="6,0,0,0" Width="30"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== BOTTOM STATUS ===== -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="BottomSongName" Text="" FontSize="11"
                       Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" x:Name="SongCountText" Text="0 songs"
                       FontSize="11" Foreground="{StaticResource TextDim}"
                       VerticalAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="v0.1.0"
                       FontSize="11" Foreground="{StaticResource TextDim}"
                       VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.6"/>
        </Grid>
    </Grid>
</Window>